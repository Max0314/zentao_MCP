# 云上 .env 模板。复制到仓库根目录改名为 .env 并 chmod 600。
# .env 是 gitignore 的，只存在于服务器本机。

# 只绑回环：nginx 就在本机反代，外面不需要直连。
# 绑 0.0.0.0 等于在 47.108.48.50 上开一个绕过 TLS、key 校验和限速的明文入口。
MCP_BIND=127.0.0.1

# 宿主机侧的发布端口，要和 ~/.nginx/zentao-mcp.conf 里 proxy_pass 的端口一致。
# 和 config.yaml 无关：容器内固定监听 7892，compose 做 39029 -> 7892 的映射。
MCP_PORT=39029

# 建索引的服务账号口令。留空时服务照常启动，只是跳过建索引并在启动日志里告警。
ZENTAO_INDEX_PASSWORD=
